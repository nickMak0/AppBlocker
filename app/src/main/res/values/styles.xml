<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.ScheduleSettings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Expanded Toolbar Title -->
    <style name="ExpandedToolbarTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Modern Day Chip Style -->
    <style name="ModernDayChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@drawable/chip_day_background_selector</item>
        <item name="android:textColor">@drawable/chip_day_text_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@drawable/chip_day_stroke_selector</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="chipIconSize">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <!-- Time Range Item Card Style -->
    <style name="TimeRangeCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/gray_200</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Section Header Text Style -->
    <style name="SectionHeaderText" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Section Subtitle Text Style -->
    <style name="SectionSubtitleText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Modern Button Styles -->
    <style name="ModernButtonPrimary" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <style name="ModernButtonSecondary" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="rippleColor">@color/gray_200</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/gray_300</item>
    </style>

    <!-- Icon Container Style -->
    <style name="IconContainer">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Floating Action Button Style -->
    <style name="ModernFAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/white</item>
        <item name="elevation">4dp</item>
        <item name="pressedTranslationZ">8dp</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <!-- Card Container Style -->
    <style name="ModernCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="android:layout_marginVertical">8dp</item>
    </style>

    <!-- Status Chip Style -->
    <style name="StatusChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="chipIconTint">@color/on_surface_variant</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <!-- Suggestion Chip Style -->
    <style name="SuggestionChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/primary_light</item>
        <item name="android:textColor">@color/primary</item>
        <item name="chipIconTint">@color/primary</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <!-- Empty State Text Style -->
    <style name="EmptyStateTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="EmptyStateSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
</resources>