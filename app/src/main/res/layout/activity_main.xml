<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <!-- Status Bar Overlay -->
    <View
        android:id="@+id/statusBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/status_gradient_start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.08" />

    <!-- Main Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/statusBarOverlay"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Header Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/headerCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="28dp"
                    android:background="@color/card_background">

                    <!-- App Icon with Glow Effect -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconContainer"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        app:cardCornerRadius="44dp"
                        app:cardElevation="16dp"
                        app:cardBackgroundColor="@color/icon_background"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:id="@+id/appIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:src="@mipmap/ic_launcher"
                            android:contentDescription="@string/app_name"
                            android:scaleType="centerCrop" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- App Title -->
                    <TextView
                        android:id="@+id/appName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AppBlocker Pro"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:letterSpacing="0.02"
                        app:layout_constraintTop_toBottomOf="@id/iconContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="16dp" />

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/appSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus • Productivity • Control"
                        android:textSize="14sp"
                        android:textColor="@color/secondary_text"
                        android:alpha="0.8"
                        app:layout_constraintTop_toBottomOf="@id/appName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="4dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Permission Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/permissionCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/permission_border"
                app:cardBackgroundColor="@color/permission_card_background"
                app:layout_constraintTop_toBottomOf="@id/headerCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/permissionIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="@color/permission_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/permissionStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Checking permissions..."
                        android:textColor="@color/permission_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/permissionIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Toggle Switch Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/toggleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/toggle_card_background"
                app:layout_constraintTop_toBottomOf="@id/permissionCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/toggleIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_lock_lock"
                        android:tint="@color/toggle_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:id="@+id/toggleTextContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/toggleIcon"
                        app:layout_constraintEnd_toStartOf="@id/blockToggleSwitch">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Blocking"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/toggle_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Block selected apps during focus time"
                            android:textSize="14sp"
                            android:textColor="@color/toggle_subtitle"
                            android:alpha="0.7"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/blockToggleSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="1.2"
                        android:scaleY="1.2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/buttonsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/toggleCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Dashboard Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboardButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:text="Dashboard"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_menu_view"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:iconTint="@android:color/white"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/dashboard_button"
                    app:elevation="8dp"
                    app:rippleColor="@color/button_ripple"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/manageAppsButton"
                    app:layout_constraintWidth_percent="0.48" />

                <!-- Manage Apps Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manageAppsButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:text="Manage Apps"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_menu_manage"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:iconTint="@android:color/white"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/manage_apps_button"
                    app:elevation="8dp"
                    app:rippleColor="@color/button_ripple"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/dashboardButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.48" />

                <!-- Schedule Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scheduleButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:text="Schedule Settings"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/schedule_button_text"
                    app:icon="@android:drawable/ic_menu_recent_history"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:iconTint="@color/schedule_button_icon"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/schedule_button_background"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/schedule_button_border"
                    app:elevation="4dp"
                    app:rippleColor="@color/schedule_button_ripple"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/dashboardButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Stats Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/stats_card_background"
                app:layout_constraintTop_toBottomOf="@id/buttonsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/statsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Focus"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/stats_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/statsTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="47"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/stats_number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Apps Blocked"
                                android:textSize="12sp"
                                android:textColor="@color/stats_label"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:background="@color/stats_divider"
                            android:alpha="0.3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2h 34m"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/stats_number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Focus Time"
                                android:textSize="12sp"
                                android:textColor="@color/stats_label"
                                android:alpha="0.7" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>