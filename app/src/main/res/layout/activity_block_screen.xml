<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#000000">

    <!-- Blocked Message -->
    <TextView
        android:id="@+id/blockedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app is blocked"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:textAlignment="center" />

    <!-- Motivational Quote -->
    <TextView
        android:id="@+id/motivationQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay strong. Stay focused."
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:paddingBottom="24dp"
        android:textAlignment="center" />

    <!-- Strict Mode Text -->
    <TextView
        android:id="@+id/strictModeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Strict Mode: Ultra-fast blocking active"
        android:textColor="#EF4444"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:textAlignment="center"
        android:visibility="gone" />

    <!-- Close Button -->
    <Button
        android:id="@+id/closeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Close"
        android:visibility="visible"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF" />
</LinearLayout>
