<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E0E7FF">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_add"
                app:tint="#6366F1" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Time Range"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set your active hours"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Time Selection Section -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E5E7EB"
        app:cardBackgroundColor="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Start Time Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#6366F1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Start Time"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startTimeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="09:00 AM"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#6366F1"
                    app:cornerRadius="12dp"
                    app:strokeColor="#6366F1"
                    app:strokeWidth="2dp"
                    app:backgroundTint="#FFFFFF"
                    tools:text="09:00 AM" />

            </LinearLayout>

            <!-- End Time Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#F59E0B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="End Time"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/endTimeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="05:00 PM"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#F59E0B"
                    app:strokeWidth="2dp"
                    app:backgroundTint="#FFFFFF"
                    tools:text="05:00 PM" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Duration Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/durationChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration: 8 hours"
            android:textSize="12sp"
            app:chipIcon="@android:drawable/ic_menu_agenda"
            app:chipIconTint="#64748B"
            android:textColor="#64748B"
            app:chipBackgroundColor="#F1F5F9"
            app:chipCornerRadius="12dp"
            tools:text="Duration: 8 hours" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="#64748B"
            android:minWidth="80dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add Range"
            app:icon="@android:drawable/ic_input_add"
            app:cornerRadius="12dp"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:minWidth="120dp" />

    </LinearLayout>

</LinearLayout>