<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Dashboard Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/dashboardButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Dashboard"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:icon="@android:drawable/ic_menu_view"
        app:iconSize="24dp"
        app:iconPadding="12dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/dashboard_button"
        app:elevation="8dp"
        app:rippleColor="@color/button_ripple"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/manageAppsButton"
        app:layout_constraintWidth_percent="0.48" />

    <!-- Manage Apps Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/manageAppsButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Manage Apps"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:icon="@android:drawable/ic_menu_manage"
        app:iconSize="24dp"
        app:iconPadding="12dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/manage_apps_button"
        app:elevation="8dp"
        app:rippleColor="@color/button_ripple"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/dashboardButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.48" />

    <!-- Schedule Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scheduleButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Schedule Settings"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/schedule_button_text"
        app:icon="@android:drawable/ic_menu_recent_history"
        app:iconSize="24dp"
        app:iconPadding="12dp"
        app:iconTint="@color/schedule_button_icon"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/schedule_button_background"
        app:strokeWidth="2dp"
        app:strokeColor="@color/schedule_button_border"
        app:elevation="4dp"
        app:rippleColor="@color/schedule_button_ripple"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/dashboardButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>